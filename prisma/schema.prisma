generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model FoodScan {
  id                  String   @id @default(cuid())
  imageHash           String?  
  foodName            String
  ingredients         Json     
  isVegan             Boolean
  nonVeganIngredients Json?    
  analysis            String   @db.Text
  alternatives        VeganAlternative[]
  createdAt           DateTime @default(now())

  @@index([imageHash])
}

model VeganAlternative {
  id                  String   @id @default(cuid())
  scanId              String
  scan                FoodScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  originalIngredient  String
  alternativeName     String
  nutritionMatch      String
  recipe              String   @db.Text
  buyLink             String
  createdAt           DateTime @default(now())

  @@index([scanId])
}
