# Groq API Key — required for AI analysis
# Get yours at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# PostgreSQL Database (Prisma)
# For local development, use a local PostgreSQL instance or a free hosted DB (e.g., Supabase, Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/karunya?schema=public"

# Direct connection URL (used by Prisma for migrations; same as DATABASE_URL for non-pooled connections)
DIRECT_URL="postgresql://user:password@localhost:5432/karunya?schema=public"

# Node environment
NODE_ENV=development
